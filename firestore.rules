rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return hasProfile() && myProfile().role == 'admin'; }

    match /users/{uid} {
      // اسناد پروفایل نباید شامل اطلاعات حساس باشند.
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'employee'
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.online is bool
        && request.resource.data.lastSeen == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /breakSessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.employeeEmail == request.auth.token.email
        && request.resource.data.status == 'active'
        && request.resource.data.plannedMinutes is int
        && request.resource.data.plannedMinutes >= 1
        && request.resource.data.plannedMinutes <= 60
        && request.resource.data.endAt == null;
      allow update: if signedIn()
        && resource.data.employeeUid == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.employeeUid == resource.data.employeeUid
        && request.resource.data.employeeEmail == resource.data.employeeEmail
        && request.resource.data.employeeName == resource.data.employeeName
        && request.resource.data.plannedMinutes == resource.data.plannedMinutes
        && request.resource.data.startAt == resource.data.startAt
        && request.resource.data.startAtClient == resource.data.startAtClient
        && request.resource.data.status == 'completed'
        && request.resource.data.endAt != null;
      allow delete: if isAdmin();
    }

    match /breakReservations/{reservationId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.employeeUid == request.auth.uid
        && request.resource.data.employeeEmail == request.auth.token.email
        && request.resource.data.status == 'booked'
        && request.resource.data.plannedMinutes is int
        && request.resource.data.plannedMinutes >= 1
        && request.resource.data.plannedMinutes <= 60
        && request.resource.data.startAt is timestamp
        && request.resource.data.startAt > request.time;
      allow update: if signedIn()
        && resource.data.employeeUid == request.auth.uid
        && resource.data.status == 'booked'
        && request.resource.data.employeeUid == resource.data.employeeUid
        && request.resource.data.employeeEmail == resource.data.employeeEmail
        && request.resource.data.employeeName == resource.data.employeeName
        && request.resource.data.plannedMinutes == resource.data.plannedMinutes
        && request.resource.data.startAt == resource.data.startAt
        && request.resource.data.status in ['cancelled', 'started']
        && (request.resource.data.status == 'cancelled' || request.time >= resource.data.startAt);
      allow delete: if isAdmin();
    }
  }
}
